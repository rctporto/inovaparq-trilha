# Banco PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inovaparq"

# Auth.js — gere com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET=""
# Em produção atrás de proxy/Vercel, defina a URL pública ou AUTH_TRUST_HOST=true
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Login com Google (Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth)
# URI de redirecionamento autorizado: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# E-mails que viram conta Desenvolvedor (ativa) automaticamente no primeiro acesso.
# Separe por vírgula. Use para criar a primeira conta que aprova as demais.
BOOTSTRAP_DEV_EMAILS=""

# Opcional: o seed cria/atualiza esta conta Desenvolvedor com senha (não versionar a senha!)
SEED_DEV_EMAIL=""
SEED_DEV_PASSWORD=""
